# Porta HTTP publicada somente neste computador.
APP_PORT=8080

# Detalhes de erros na resposta JSON. Ative apenas para depuração local.
APP_DEBUG=false

# A aplicação recebe somente as credenciais deste usuário, limitado ao seu banco.
DB_DATABASE=gerador_de_provas
DB_USERNAME=gerador
DB_PASSWORD=

# Escolha outra senha para administração. Ela não é enviada ao serviço app.
MYSQL_ROOT_PASSWORD=

# Crie a chave em https://aistudio.google.com/api-keys e confira se o projeto é Free Tier.
# A chave fica apenas no backend. Não é necessária para health, BNCC ou testes simulados.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Sessão local por cookie HttpOnly. Ative Secure ao configurar HTTPS.
AUTH_COOKIE_SECURE=false
# Hosts e origens confiáveis. Origens vazias usam os endereços locais previstos no projeto.
AUTH_ALLOWED_HOSTS=localhost,127.0.0.1,::1
AUTH_ALLOWED_ORIGINS=

# Cotas de tentativas admitidas na IA, por dia UTC. Zero não desativa limites.
GENERATION_USER_DAILY_LIMIT=20
GENERATION_GLOBAL_DAILY_LIMIT=100
GENERATION_MIN_INTERVAL_SECONDS=10
GENERATION_MAX_CONCURRENT=2
